<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.LessonPeriodMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.model.LessonPeriod">
        <id     column="period_id"  property="periodId"/>
        <result column="lesson_id"  property="lessonId"/>
        <result column="seq"        property="seq"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time"   property="endTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="periodId" keyColumn="period_id">
        INSERT INTO lesson_period (lesson_id, seq, start_time, end_time)
        VALUES (#{lessonId}, #{seq}, #{startTime}, #{endTime})
    </insert>

    <delete id="deleteByLesson">
        DELETE FROM lesson_period WHERE lesson_id = #{lessonId}
    </delete>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT period_id, lesson_id, seq, start_time, end_time
        FROM lesson_period
        <where>
            <if test="lessonId != null">
                lesson_id = #{lessonId}
            </if>
        </where>
        ORDER BY lesson_id, seq
    </select>

</mapper>
